{
  "name": "manic-bot",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpileOnly src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:make": "node --loader ts-node/esm ./node_modules/knex/bin/cli.js migrate:make -x ts --knexfile ./knexfile.ts",
    "migrate:latest": "node --loader ts-node/esm ./node_modules/knex/bin/cli.js migrate:latest --knexfile ./knexfile.ts",
    "migrate:rollback": "node --loader ts-node/esm ./node_modules/knex/bin/cli.js migrate:rollback --knexfile ./knexfile.ts",
    "seed:run": "node --loader ts-node/esm ./node_modules/knex/bin/cli.js seed:run --knexfile ./knexfile.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "mysql2": "^3.11.0",
    "pino": "^9.3.0",
    "pino-http": "^10.2.0",
    "prom-client": "^15.1.2",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "pino-pretty": "^13.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
